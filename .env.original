# BSG Demo Platform - Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=BSG Demo Platform
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=True

# API Settings
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ===========================================
# Database Settings
# ===========================================
# MongoDB connection string - Azure Cosmos DB
DATABASE_URL=mongodb://bsg-demo-platform-mongodb:wC418aLYO4SazuhljALVOclZc48spvoHidWukgFDOoBCjO5Z4wjjKPziuJ44TAUyVlOs89HeL4a5ACDbdAs80w==@bsg-demo-platform-mongodb.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@bsg-demo-platform-mongodb@
DATABASE_NAME=bsg_demo

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate a secure key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS Settings
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# ===========================================
# Logging Settings
# ===========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=  # Optional: path to log file

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# Redis Cache (Optional)
# ===========================================
# Redis connection string (optional)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=False
CACHE_TTL=300

# ===========================================
# Video Storage
# ===========================================
VIDEO_STORAGE_PATH=./uploads/videos
VIDEO_MAX_SIZE_MB=500
VIDEO_ALLOWED_FORMATS=mp4,mov,avi,webm
VIDEO_CHUNK_SIZE=1048576  # 1MB in bytes

# ===========================================
# Security
# ===========================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SECURE_COOKIES=True

# ===========================================
# External API Integration
# ===========================================
TEMENOS_DEV_PORTAL_APIKEY=0M64aZd2DEKHigO9paN43i6JCvtTLjdK

# ===========================================
# Monitoring
# ===========================================
METRICS_ENABLED=True
TRACING_ENABLED=False

# ===========================================
# Health Check
# ===========================================
HEALTH_CHECK_TIMEOUT=5

# ===========================================
# Production-Only Settings
# ===========================================
# Only used when ENVIRONMENT=production

# Secret Management
# AWS_SECRETS_MANAGER_NAME=
# VAULT_URL=
# VAULT_TOKEN=

# SSL/TLS
# SSL_CERT_PATH=
# SSL_KEY_PATH=
